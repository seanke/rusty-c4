// An example landscape with three levels of nesting to dive through.

specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system
  element container
  element component {
    style {
      color secondary
    }
  }
  element database {
    style {
      shape storage
      color slate
    }
  }
  element queue {
    style {
      shape queue
      color indigo
    }
  }
  element webapp {
    style {
      shape browser
      color sky
    }
  }
  element mobileapp {
    style {
      shape mobile
      color sky
    }
  }
  element external {
    style {
      color muted
    }
  }
}

model {
  customer = actor 'Customer' 'Browses the catalogue and places orders'
  support = actor 'Support Agent' 'Helps customers with orders and refunds'

  shop = system 'Online Shop' 'Everything a customer needs to find and buy things from us' {
    web = webapp 'Storefront' 'Server-rendered shop front' 'Next.js'
    mobile = mobileapp 'Mobile App' 'Native shopping app' 'Swift / Kotlin'
    gateway = container 'API Gateway' 'Routing, auth and rate limiting' 'Envoy'

    catalog = container 'Catalog Service' 'Products, prices and search' 'Go' {
      api = component 'Catalog API' 'REST and GraphQL endpoints' 'gqlgen'
      search = component 'Search Indexer' 'Keeps the search index fresh' 'Go'
      pricing = component 'Pricing Engine' 'Discounts and promotions' 'Go'
      catalogDb = database 'Catalog DB' 'Products and prices' 'PostgreSQL'

      api -> pricing 'computes prices'
      api -> catalogDb 'reads'
      search -> catalogDb 'watches changes'
    }

    orders = container 'Order Service' 'Carts, checkout and order history' 'Kotlin' {
      cart = component 'Cart' 'Session carts' 'Spring'
      checkout = component 'Checkout' 'Turns carts into orders' 'Spring'
      history = component 'Order History' 'Past orders and invoices' 'Spring'
      ordersDb = database 'Orders DB' 'Orders and carts' 'PostgreSQL'

      cart -> ordersDb 'stores carts'
      checkout -> cart 'reads cart'
      checkout -> ordersDb 'writes orders'
      history -> ordersDb 'reads'
    }

    events = queue 'Event Bus' 'Domain events between services' 'Kafka'
    notify = container 'Notifications' 'Email, SMS and push' 'Node.js'
  }

  payments = external 'Payment Provider' 'Card and wallet payments' 'Stripe'

  warehouse = system 'Warehouse' 'Picks, packs and ships orders' {
    wms = container 'WMS' 'Warehouse management' 'SAP'
    scanners = mobileapp 'Scanner App' 'Handheld picking' 'Android'
    scanners -> wms 'confirms picks'
  }

  backoffice = system 'Back Office' 'Internal tools for staff' {
    admin = webapp 'Admin Console' 'Refunds, customers and catalogue editing' 'React'
  }

  customer -> shop.web 'browses and buys'
  customer -> shop.mobile 'shops on the go'
  shop.web -> shop.gateway 'API calls' 'HTTPS'
  shop.mobile -> shop.gateway 'API calls' 'HTTPS'
  shop.gateway -> shop.catalog.api 'product queries'
  shop.gateway -> shop.orders.checkout 'checkout'
  shop.gateway -> shop.orders.cart 'cart updates'
  shop.gateway -> shop.orders.history 'order history'
  shop.orders.checkout -> payments 'charges card'
  shop.orders.checkout -> shop.events 'OrderPlaced'
  shop.catalog.pricing -> shop.events 'PriceChanged'
  shop.events -> shop.notify 'order events'
  shop.events -> warehouse.wms 'ship orders'
  shop.notify -> customer 'sends updates'
  support -> backoffice.admin 'manages orders'
  backoffice.admin -> shop.gateway 'admin API'
  warehouse.wms -> shop.events 'OrderShipped'
}

views {
  view index {
    include *
  }

  dynamic view checkout {
    title 'Checkout'
    description 'A customer pays for what is in their cart'

    customer -> shop.web 'opens their cart'
    shop.web -> shop.gateway 'POST /checkout'
    shop.gateway -> shop.orders.checkout 'place order'
    shop.orders.checkout -> shop.orders.cart 'read cart'
    shop.orders.checkout -> payments 'charge card'
    shop.orders.checkout <- payments 'payment confirmed'
    parallel {
      shop.orders.checkout -> shop.orders.ordersDb 'save order'
      shop.orders.checkout -> shop.events 'OrderPlaced'
    }
    shop.events -> shop.notify 'order event'
    shop.notify -> customer 'confirmation email'
  }

  dynamic view browse {
    title 'Browsing the catalogue'
    description 'Searching for products on the mobile app'

    customer -> shop.mobile 'searches'
    shop.mobile -> shop.gateway 'GET /products'
    shop.gateway -> shop.catalog.api 'product query'
    parallel {
      shop.catalog.api -> shop.catalog.catalogDb 'read products'
      shop.catalog.api -> shop.catalog.pricing 'compute prices'
    }
    shop.gateway <- shop.catalog.api 'results'
    shop.mobile <- shop.gateway 'product list'
  }

  dynamic view fulfilment {
    title 'Fulfilment'
    description 'From a placed order to a parcel at the door'

    shop.events -> warehouse.wms 'ship order'
    warehouse.scanners -> warehouse.wms 'items picked'
    warehouse.wms -> shop.events 'OrderShipped'
    shop.events -> shop.notify 'shipping event'
    shop.notify -> customer 'tracking link'
  }
}
